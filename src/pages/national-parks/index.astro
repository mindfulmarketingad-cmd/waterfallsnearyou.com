---
import Base from '../../layouts/Base.astro';
import PageBand from '../../components/PageBand.astro';
import { getParks, parkQualifies } from '../../lib/parks.mjs';
import { hubCopy } from '../../lib/park-copy.mjs';
import { fmtNum } from '../../lib/format.mjs';
import { SITE } from '../../config.mjs';

const parks = getParks().filter(parkQualifies);
const states = [...new Set(parks.flatMap((p) => p.falls.map((f) => f.state)))].sort();
const groups = states.map((state) => ({
  state,
  parks: parks.filter((p) => p.falls.some((f) => f.state === state)).sort((a, b) => a.name.localeCompare(b.name)),
}));
const crumbs = [{ name: 'Home', url: '/' }, { name: 'National Parks', url: '/national-parks' }];
const title = 'National park waterfalls';
const description = `Waterfall guides for ${parks.length} US national parks, matched to official boundaries, with trail stats, fees, and stream-gauge timing where a source exists.`;
const schema = [{
  '@type': 'CollectionPage',
  name: title,
  url: `${SITE.url}/national-parks`,
  description,
  author: { '@type': 'Person', name: 'David F.', url: `${SITE.url}/about` },
}];
---
<Base title={`${title} | WaterfallsNearYou`} description={description} breadcrumbs={crumbs} bandCrumbs schema={schema}>
  <PageBand title={title} crumbs={crumbs}>
    <p>{hubCopy.dek}</p>
  </PageBand>
  <article class="wrap narrow section-sm prose">
    <div class="byline">
      <span class="avatar" aria-hidden="true">DF</span>
      <div>
        <div class="by-name">By <a href="/about">David F.</a></div>
        <div class="by-meta">Boundary match and source check, November 19, 2026.</div>
      </div>
    </div>
    {hubCopy.paragraphs.map((p) => <p>{p}</p>)}
    <p>Heights for the falls in these parks, set next to every other state, are in <a href="/blog/largest-waterfalls-in-the-us-by-state">Largest waterfalls in the United States, by state</a>. That guide uses a park sentence or a USGS sentence and leaves the height blank when neither exists.</p>
    <p>{fmtNum(parks.length)} parks qualify, covering {fmtNum(parks.reduce((s, p) => s + p.falls.length, 0))} published waterfall pages. The list is grouped by the state of those falls. A park on a state line appears in each state where one of its falls sits.</p>
    <label class="small" for="park-sort">Sort</label>
    <select id="park-sort">
      <option value="state">By state</option>
      <option value="falls">By number of waterfalls</option>
      <option value="name">By park name</option>
    </select>
    <div id="park-groups">
      {groups.map((g) => (
        <section class="park-group" data-state={g.state}>
          <h2>{g.state}</h2>
          <ul class="park-index">
            {g.parks.map((p) => {
              const inState = p.falls.filter((f) => f.state === g.state);
              return (
                <li data-name={p.name} data-count={p.falls.length}>
                  <a href={p.url}><strong>{p.name}</strong></a>
                  <span class="muted small">{inState.length} published {inState.length === 1 ? 'waterfall' : 'waterfalls'} in {g.state}{p.falls.length !== inState.length ? `, ${p.falls.length} in the park` : ''}</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </article>
</Base>
<script>
  const select = document.getElementById('park-sort');
  const root = document.getElementById('park-groups');
  const original = root.innerHTML;
  select?.addEventListener('change', () => {
    if (select.value === 'state') {
      root.innerHTML = original;
      return;
    }
    const items = [...root.querySelectorAll('li')];
    const seen = new Set();
    const unique = items.filter((li) => {
      const name = li.dataset.name;
      if (seen.has(name)) return false;
      seen.add(name);
      return true;
    });
    unique.sort((a, b) => select.value === 'falls'
      ? Number(b.dataset.count) - Number(a.dataset.count) || a.dataset.name.localeCompare(b.dataset.name)
      : a.dataset.name.localeCompare(b.dataset.name));
    root.innerHTML = `<section class="park-group"><h2>${select.value === 'falls' ? 'Most waterfalls on our pages' : 'All parks'}</h2><ul class="park-index"></ul></section>`;
    const ul = root.querySelector('ul');
    for (const li of unique) ul.append(li);
  });
</script>
