---
import Base from '../../layouts/Base.astro';
import PageBand from '../../components/PageBand.astro';
import WaterfallMap from '../../components/WaterfallMap.astro';
import MapHubLinks from '../../components/MapHubLinks.astro';
import Faq from '../../components/Faq.astro';
import { loadData } from '../../lib/core.mjs';
import { point, MAP_YEAR, mapStates } from '../../lib/maps.mjs';
import { fmtNum } from '../../lib/format.mjs';
import { SITE } from '../../config.mjs';

const { listings } = loadData();
const states = mapStates();
const ranked = [...states].sort((a, b) => b.listings.length - a.listings.length);
const rated = listings.filter((l) => l.os?.rating).length;
const title = `United States Waterfall Map ${MAP_YEAR}`;
const description = `Interactive map of ${fmtNum(listings.length)} waterfalls across the United States. Tap any marker to open that waterfall's page with directions, photos and live weather.`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Map', url: '/map' }];
const faqs = [
  { q: 'How many waterfalls are on this map?', a: `The map shows ${fmtNum(listings.length)} waterfalls in ${states.length - 1} states and the District of Columbia. ${fmtNum(rated)} of them have Google visitor ratings, shown as green markers; gray markers are officially named falls that have not been rated yet.` },
  { q: 'Which state has the most waterfalls on the map?', a: `${ranked[0].name} has the most with ${ranked[0].listings.length}, followed by ${ranked[1].name} (${ranked[1].listings.length}) and ${ranked[2].name} (${ranked[2].listings.length}). Open the <a href="/map/${ranked[0].slug}">${ranked[0].name} waterfall map</a> to zoom in.` },
  { q: 'Where does the map data come from?', a: 'Waterfall locations come from the U.S. Geological Survey Geographic Names Information System, enriched with ratings and photos from Google Maps listings. Map tiles are from OpenStreetMap.' },
  { q: 'How do I find waterfalls near me on the map?', a: 'Zoom into your area and tap the nearest markers, or pick your state below for a closer view. You can also use <a href="/search">search</a> to list the waterfalls closest to your location.' },
  { q: 'Are the marker locations exact?', a: 'Markers show the recorded position of each waterfall, not the trailhead or parking area. Use the directions on each waterfall page and check access before you go.' },
];
const schema = [
  { '@type': 'WebPage', name: title, url: `${SITE.url}/map`, description },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) },
];
---
<Base title={title} description={description} breadcrumbs={crumbs} bandCrumbs schema={schema}>
  <PageBand title={title} crumbs={crumbs}>
    <p>Every waterfall in our directory on one map: {fmtNum(listings.length)} falls from the Pacific Northwest to the Appalachians, Hawaii and Alaska. Tap a marker to open that waterfall's page, or choose a state map below for a closer look.</p>
  </PageBand>
  <section class="wrap section-sm">
    <WaterfallMap points={listings.map(point)} label="Map of waterfalls in the United States" bounds={[[24.4, -125], [49.4, -66.9]]} height={680} />
  </section>
  <section class="wrap section-sm"><MapHubLinks /></section>
  <section class="wrap section narrow"><Faq faqs={faqs} heading="Frequently asked questions" /></section>
</Base>
