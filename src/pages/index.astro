---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import ListingCard from '../components/ListingCard.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { loadData, imageFor } from '../lib/core.mjs';
import { getPosts } from '../lib/blog.mjs';
import { fmtNum } from '../lib/format.mjs';
import { SITE } from '../config.mjs';

const { listings, states, cities } = loadData();
const featured = [...listings].sort((a, b) => b.score - a.score || a.name.localeCompare(b.name)).slice(0, 12);
const ranked = [...states].sort((a, b) => b.listings.length - a.listings.length);
const posts = getPosts();
const pick = (slug) => posts.find((p) => p.slug === slug) || posts[0];
const trio = [pick('waterfall-safety-tips'), pick('best-time-to-visit-waterfalls'), pick('waterfall-photography-tips')];
const title = 'Waterfalls Near Me | Hidden Locations For Scenic Hikes';
const description = `Find waterfalls near you. Browse ${fmtNum(listings.length)} named waterfalls in ${states.length - 1} states plus DC, with maps, GPS coordinates, directions and nearby towns.`;
const faqs = [
  { q: 'How do I find waterfalls near me?', a: `Allow location access on this page and we will list the closest named waterfalls to you, or type your town into the search bar. You can also browse <a href="/states">waterfalls by state</a> and open your nearest town to see every waterfall ranked by distance.` },
  { q: 'How many waterfalls are listed on WaterfallsNearYou?', a: `We list ${fmtNum(listings.length)} officially named waterfalls from the USGS Geographic Names Information System, grouped around ${fmtNum(cities.length)} towns in ${states.length - 1} states and the District of Columbia.` },
  { q: 'Which state has the most waterfalls?', a: `${ranked[0].name} has the most officially named waterfalls (${ranked[0].listings.length}), followed by ${ranked[1].name} (${ranked[1].listings.length}) and ${ranked[2].name} (${ranked[2].listings.length}). Read <a href="/blog/states-with-the-most-waterfalls">states with the most named waterfalls</a>.` },
  { q: 'When is the best time to visit a waterfall?', a: 'Most waterfalls flow strongest in spring during snowmelt and after a few days of steady rain. Late summer and drought periods can reduce some falls to a trickle. See <a href="/blog/best-time-to-visit-waterfalls">the best time to visit waterfalls</a>.' },
  { q: 'Is it safe to swim at waterfalls?', a: 'Often it is not. Cold water, hidden rocks, strong recirculating currents and slick ledges cause injuries every year. Read <a href="/blog/swimming-at-waterfalls">is it safe to swim at waterfalls</a> before getting in the water.' },
  { q: 'Are the waterfalls on this site free to visit?', a: 'Many are on public land, but some sit inside parks with entrance fees and some are on private property with no public access. Each listing links to maps and directions; always confirm access with the land manager.' },
];
const schema = [
  { '@type': 'WebPage', name: title, url: SITE.url, description, primaryImageOfPage: `${SITE.url}/media/hero-landscape.webp` },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) },
];
---
<Base title={title} description={description} image="/media/hero-landscape.webp" imageAlt="A waterfall pouring into a green swimming hole surrounded by wildflowers" schema={schema}>
  <section class="hero">
    <video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="none" poster="/media/hero-landscape.webp" aria-hidden="true" data-landscape="/media/hero-landscape.mp4" data-portrait="/media/hero-portrait.mp4" data-portrait-poster="/media/hero-portrait.webp"></video>
    <div class="hero-shade"></div>
    <div class="wrap hero-inner">
      <h1><span class="h1-main">Waterfalls Near Me</span> <span class="h1-sub">| Hidden Locations For Scenic Hikes</span></h1>
      <p class="hero-lead">Search {fmtNum(listings.length)} named waterfalls across the United States, from roadside cascades to backcountry plunges.</p>
      <SearchForm id="home-q" />
      <p class="hero-links">Popular: {ranked.slice(0, 5).map((s, i) => <>{i ? ' · ' : ''}<a href={s.url}>{s.name}</a></>)}</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p>Whether you are a seasoned hiker, a parent looking for a family-friendly walk, or chasing a cool mountain stream on a hot day, <strong>there is a waterfall near you.</strong></p>
    </div>
  </section>

  <section class="section-sm" aria-labelledby="near-you">
    <div class="wrap">
      <div class="near-head">
        <div>
          <span class="eyebrow">Tailored to your location</span>
          <h2 id="near-you">Waterfalls Near You</h2>
          <p id="near-status" class="muted" role="status" aria-live="polite">Popular waterfalls across the country. Allow location to see the falls closest to you.</p>
        </div>
        <div class="near-actions">
          <button class="btn btn-outline" type="button" id="use-location"><Icon name="locate" />Use my location</button>
          <button class="carousel-btn" type="button" data-dir="-1" aria-label="Previous waterfalls"><Icon name="arrowL" /></button>
          <button class="carousel-btn" type="button" data-dir="1" aria-label="Next waterfalls"><Icon name="arrowR" /></button>
        </div>
      </div>
      <div class="carousel" id="carousel" tabindex="0" aria-label="Waterfalls near you">
        {featured.map((l) => <div class="slide"><ListingCard listing={l} /></div>)}
      </div>
      <p id="near-more" class="small" style="margin-top:12px"></p>
    </div>
  </section>

  <section class="split split-image" style={`--bg:url(${imageFor('/states')})`}>
    <div class="wrap split-inner">
      <div class="split-copy">
        <span class="eyebrow light">Explore the directory</span>
        <h2>Visit {fmtNum(listings.length)} waterfalls in {states.length - 1} states and DC</h2>
        <p>From the glacier-carved valleys of the Pacific Northwest to the Blue Ridge escarpment and the ledges of the Great Lakes, every named waterfall in the federal gazetteer has its own page with coordinates, the USGS topo map, nearby towns and directions.</p>
        <a class="btn btn-light" href="/states">Browse waterfalls by state</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-3">
        <article class="card">
          <img src={imageFor(trio[0].url)} alt={trio[0].imageAlt} width="1200" height="630" loading="lazy" />
          <div class="body"><h3><a href={trio[0].url}>Stay safe around falling water.</a></h3><p>Slick rock, cold water and strong currents catch visitors off guard every year. Learn the rules experienced hikers follow.</p></div>
        </article>
        <article class="card">
          <img src={imageFor(trio[1].url)} alt={trio[1].imageAlt} width="1200" height="630" loading="lazy" />
          <div class="body"><h3><a href={trio[1].url}>Time your visit for peak flow.</a></h3><p>Snowmelt, rainfall and season decide whether a waterfall roars or trickles. Here is how to plan around it.</p></div>
        </article>
        <article class="card">
          <img src={imageFor(trio[2].url)} alt={trio[2].imageAlt} width="1200" height="630" loading="lazy" />
          <div class="body"><h3><a href={trio[2].url}>Photograph silky water.</a></h3><p>Shutter speed, filters and overcast light make the difference between a snapshot and a frame worth printing.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-mist section">
    <div class="wrap">
      <span class="eyebrow">Browse by state</span>
      <h2>Find Waterfalls in Your State</h2>
      <ul class="tile-list">
        {states.map((s) => <li><a href={s.url}><span>{s.name}</span><span class="count">{s.listings.length}</span></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2 about-split">
      <div>
        <span class="eyebrow">Why we built this</span>
        <h2>Hidden locations, real coordinates</h2>
        <p>Most waterfall lists repeat the same famous falls. We started from the official federal record instead: the U.S. Geological Survey's Geographic Names Information System, which catalogs every officially named waterfall in the country, including hundreds that rarely appear in guidebooks.</p>
        <p>Each waterfall is matched to its nearest town, so you can open the page for a place you know and see every named fall around it, ranked by distance. Listings include GPS coordinates, the USGS topographic map name, nearby landmarks and one-tap directions.</p>
        <a class="btn btn-primary" href="/about">About WaterfallsNearYou</a>
      </div>
      <figure class="about-photo">
        <img src="/media/waterfall-swimming-hole.webp" alt="A waterfall spilling into a wide green pool with yellow wildflowers in the foreground" width="800" height="1422" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="bg-slate section">
    <div class="wrap">
      <div class="stats">
        <div><strong>{fmtNum(listings.length)}</strong><span>named waterfalls</span></div>
        <div><strong>{states.length - 1}</strong><span>states plus DC</span></div>
        <div><strong>{fmtNum(cities.length)}</strong><span>town guides</span></div>
        <div><strong>{ranked[0].listings.length}</strong><span>waterfalls in {ranked[0].name}</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">From the blog</span>
      <h2>Plan a Better Waterfall Hike</h2>
      <div class="grid-3">
        {posts.slice(0, 6).map((p) => (
          <article class="card">
            <img src={imageFor(p.url)} alt={p.imageAlt} width="1200" height="630" loading="lazy" />
            <div class="body"><span class="eyebrow">{p.category}</span><h3><a href={p.url}>{p.title}</a></h3><p>{p.description}</p></div>
          </article>
        ))}
      </div>
      <p style="margin-top:24px"><a class="btn btn-outline" href="/blog">All articles</a></p>
    </div>
  </section>

  <section class="bg-mist section">
    <div class="wrap narrow"><Faq faqs={faqs} heading="Waterfalls Near Me: Frequently Asked Questions" /></div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: min(86vh, 760px); display: flex; align-items: center; color: #fff; overflow: hidden; background: #2f3a36 url('/media/hero-landscape.webp') center / cover no-repeat; }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(30, 34, 37, 0.35) 0%, rgba(30, 34, 37, 0.55) 60%, rgba(30, 34, 37, 0.7) 100%); }
  .hero-inner { position: relative; padding-top: 80px; padding-bottom: 80px; }
  .hero h1 { color: #fff; max-width: 820px; margin-bottom: 14px; text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35); }
  .h1-main { display: block; font-size: clamp(2.6rem, 6.5vw, 4.6rem); line-height: 1.02; }
  .h1-sub { display: block; font-size: clamp(1.2rem, 2.6vw, 1.75rem); font-weight: 500; margin-top: 10px; color: #eef3f1; }
  .hero-lead { font-size: 1.15rem; max-width: 600px; color: #f1f4f3; margin-bottom: 24px; }
  .hero-links { margin-top: 16px; font-size: 0.95rem; color: #e4ebe8; }
  .hero-links a { color: #fff; }
  .band { background: var(--slate); color: #fff; text-align: center; padding: 34px 0; }
  .band p { max-width: 820px; margin: 0 auto; font-family: var(--font-head); font-size: 1.25rem; font-style: italic; }
  .near-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; margin-bottom: 18px; }
  .near-head h2 { margin-bottom: 4px; }
  .near-head p { margin: 0; }
  .near-actions { display: flex; gap: 8px; align-items: center; }
  .carousel-btn { width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--line); background: #fff; color: var(--slate); display: grid; place-items: center; cursor: pointer; }
  .carousel-btn:hover { border-color: var(--slate); }
  .carousel-btn svg { width: 20px; height: 20px; }
  .carousel { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 3 * 20px) / 4); gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding: 4px 2px 14px; scrollbar-width: thin; }
  .slide { scroll-snap-align: start; display: flex; }
  .slide :global(.card) { width: 100%; }
  @media (max-width: 960px) { .carousel { grid-auto-columns: calc((100% - 20px) / 2.2); } }
  @media (max-width: 560px) { .carousel { grid-auto-columns: 82%; } }
  .split { position: relative; color: #fff; background: var(--slate-dark); }
  .split-image::before { content: ''; position: absolute; inset: 0; background: var(--bg) center / cover; opacity: 0.35; }
  .split-inner { position: relative; padding-top: 90px; padding-bottom: 90px; }
  .split-copy { max-width: 560px; }
  .split h2 { color: #fff; }
  .eyebrow.light { color: #cfe3d8; }
  .about-split { align-items: center; }
  .about-photo { margin: 0; }
  .about-photo img { border-radius: var(--radius); width: 100%; max-height: 520px; object-fit: cover; box-shadow: var(--shadow); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: center; }
  .stats strong { display: block; font-family: var(--font-head); font-size: clamp(2rem, 4vw, 2.8rem); color: #fff; font-weight: 600; }
  .stats span { color: #dbe2df; }
  @media (max-width: 700px) { .stats { grid-template-columns: repeat(2, 1fr); } .hero { min-height: 640px; } }
</style>

<script>
  import { loadIndex, el, nearest, ipLocation, browserLocation, imageOf, store } from '../scripts/directory.js';

  // Hero video: pick the orientation that fits the screen, skip it for reduced motion / data saver.
  const video = document.getElementById('hero-video') as HTMLVideoElement;
  const conn = (navigator as any).connection;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData;
  if (video && !calm) {
    const portrait = matchMedia('(max-aspect-ratio: 4/5)').matches;
    if (portrait) video.poster = video.dataset.portraitPoster;
    video.src = portrait ? video.dataset.portrait : video.dataset.landscape;
    video.play().catch(() => {});
  }

  const carousel = document.getElementById('carousel');
  const status = document.getElementById('near-status');
  const more = document.getElementById('near-more');
  document.querySelectorAll<HTMLButtonElement>('.carousel-btn').forEach((b) =>
    b.addEventListener('click', () => carousel.scrollBy({ left: Number(b.dataset.dir) * carousel.clientWidth * 0.9 })),
  );

  const fmt = (d) => (d < 10 ? d.toFixed(1) : Math.round(d).toString());
  const card = ({ row, d }) =>
    el('div', { class: 'slide' },
      el('article', { class: 'card' },
        el('img', { src: imageOf(row), alt: `${row[0]} near ${row[2]}, ${row[3]}`, width: '1200', height: '630', loading: 'lazy', decoding: 'async', referrerpolicy: 'no-referrer' }),
        el('div', { class: 'body' },
          el('h3', {}, el('a', { href: row[1] }, row[0])),
          el('div', { class: 'meta' }, `${row[2]}, ${row[3]} · ${fmt(d)} mi away`),
        ),
      ),
    );

  async function show(point, label) {
    const index = await loadIndex();
    const rows = nearest(index, point, 12);
    if (!rows.length) return;
    carousel.replaceChildren(...rows.map(card));
    carousel.scrollTo({ left: 0 });
    status.textContent = `The closest named waterfalls to ${label}, by straight-line distance.`;
    const town = index.c
      .map((c) => c)
      .find((c) => c[1] === rows[0].row[1].split('/').slice(0, 3).join('/'));
    more.replaceChildren(...(town ? [el('a', { href: town[1] }, `See every waterfall near ${town[0]}, ${town[2]}`)] : []));
  }

  async function usePrecise() {
    status.textContent = 'Finding your location...';
    try {
      const pos = await browserLocation();
      store.set('wny-loc', { lat: +pos.lat.toFixed(3), lng: +pos.lng.toFixed(3), t: Date.now() });
      await show(pos, 'your location');
    } catch {
      status.textContent = 'Location access was not available. Search for your town above instead.';
    }
  }
  document.getElementById('use-location').addEventListener('click', usePrecise);

  (async () => {
    const saved = store.get('wny-loc');
    if (saved && Date.now() - saved.t < 7 * 864e5) return show(saved, 'your saved location');
    const ip = await ipLocation();
    if (ip && (!ip.country || ip.country === 'US')) show(ip, ip.city ? `${ip.city}${ip.region ? `, ${ip.region}` : ''} (approximate)` : 'your approximate location');
  })();
</script>
