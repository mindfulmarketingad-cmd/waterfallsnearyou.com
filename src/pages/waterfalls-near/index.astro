---
import Base from '../../layouts/Base.astro';
import PageBand from '../../components/PageBand.astro';
import { getCityHubs, HUB_RADIUS } from '../../lib/cityhubs.mjs';
import { pagePhoto } from '../../lib/photos.mjs';
import { SITE } from '../../config.mjs';

const hubs = [...getCityHubs()].sort((a, b) => b.metro.pop - a.metro.pop);
const title = 'Waterfalls Near Major US Cities: Day-Trip Guides';
const description = `Day-trip waterfall guides for big US cities: the falls within ${HUB_RADIUS} miles of each city, with distances, ratings, fees and dog rules.`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Waterfalls Near Cities', url: '/waterfalls-near' }];
const photo = pagePhoto('/waterfalls-near', hubs.map((h) => h.picks[0].listing));
const schema = [
  { '@type': 'CollectionPage', name: title, description, url: `${SITE.url}/waterfalls-near` },
  { '@type': 'ItemList', name: title, numberOfItems: hubs.length, itemListElement: hubs.map((h, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${h.url}`, name: `Waterfalls near ${h.name}` })) },
];
---
<Base title={title} description={description} image={photo.src} imageAlt={photo.alt} breadcrumbs={crumbs} bandCrumbs schema={schema}>
  <PageBand title="Waterfalls Near Major US Cities" crumbs={crumbs} narrow />
  <div class="wrap section-sm prose" style="max-width:820px">
    <p class="lead">Planning a waterfall day trip from a big city? Each guide below lists the falls within {HUB_RADIUS} straight-line miles, with a short introduction to the region and the trip details we've checked. We're adding more cities every week.</p>
    <ul>
      {hubs.map((h) => <li><a href={h.url}>Waterfalls near {h.name}, {h.st}</a>: {h.picks.length} picks, closest {h.closest.listing.name} ({Math.round(h.closest.miles)} mi)</li>)}
    </ul>
    <p>Looking for somewhere else? Browse <a href="/states">waterfalls by state</a>, the <a href="/map">waterfall map</a> or <a href="/find">waterfalls by type</a>.</p>
  </div>
</Base>
