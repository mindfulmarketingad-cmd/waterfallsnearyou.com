---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Listicle from '../../components/Listicle.astro';
import FilterChips from '../../components/FilterChips.astro';
import Faq from '../../components/Faq.astro';
import { loadData, imageFor } from '../../lib/core.mjs';
import { fmtNum, fmtMiles, listJoin } from '../../lib/format.mjs';
import { stateInsights, stateContent } from '../../lib/insights.mjs';
import { listsForState } from '../../lib/bestof.mjs';
import { pagePhoto, stateFeatured } from '../../lib/photos.mjs';
import { SITE } from '../../config.mjs';

export function getStaticPaths() {
  return loadData().states.map((s) => ({ params: { state: s.slug }, props: { name: s.name } }));
}
const { name } = Astro.props;
const { states } = loadData();
const state = states.find((s) => s.name === name);
const ins = stateInsights(state);
const lists = listsForState(state);
const content = stateContent(state.slug);
const ordinal = (n) => n + (n % 100 >= 11 && n % 100 <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] || 'th');
const n = ins.count;
const gnisN = state.listings.filter((l) => l.source === 'gnis').length;
const isDC = state.code === 'DC';
const chips = state.cities.slice(0, 16).map((c) => ({ url: c.url, label: `Near ${c.name}`, count: c.nearby.filter((x) => x.miles <= 30).length }));
const top = state.listings.slice(0, 25).map((l) => ({ listing: l }));
const topCounties = ins.counties.slice(0, 3);
const regions = (content?.regions || []).map((r) => {
  const set = new Set(r.counties.map((c) => c.toLowerCase()));
  const ls = state.listings.filter((l) => set.has((l.county || '').toLowerCase()));
  return { ...r, listings: ls, highlights: [...ls].sort((a, b) => (b.os?.reviews || 0) - (a.os?.reviews || 0)).slice(0, 5) };
}).filter((r) => r.listings.length);
const photo = pagePhoto(state.url, stateFeatured(state));
const image = photo.src;
const title = `Waterfalls in ${state.name}: ${n} Named Falls by Town & County`;
const lead = ins.mostReviewed[0];
const description = `${fmtNum(n)} waterfalls in ${state.name}${regions.length ? `, from the ${regions[0].name}${regions[1] ? ` to the ${regions[1].name}` : ''}` : ''}${lead ? `. Most visited: ${lead.name}` : ''}. Maps, towns and directions.`.slice(0, 160);
const byCity = [...state.cities].sort((a, b) => a.name.localeCompare(b.name));
const crumbs = [{ name: 'Home', url: '/' }, { name: 'States', url: '/states' }, { name: state.name, url: state.url }];
const tagLabels = { swim: 'swimming', easy: 'easy access', family: 'families and kids', dogs: 'dogs' };
const tagLines = Object.entries(ins.tagCounts).filter(([, ls]) => ls.length).map(([k, ls]) => ({ k, label: tagLabels[k], ls }));

const faqs = [
  { q: `How many waterfalls are in ${state.name}?`, a: `Our directory lists ${fmtNum(n)} waterfall${n === 1 ? '' : 's'} in ${state.name}${gnisN < n ? ` (${fmtNum(gnisN)} officially named in the USGS Geographic Names Information System and ${fmtNum(n - gnisN)} added from Google Maps listings)` : ', all officially named in the USGS Geographic Names Information System'}, ${ordinal(ins.rank)} among the ${states.length} jurisdictions in our directory and ${ins.share}% of the national total.${ins.counties.length > 2 ? ` ${ins.top3CountyShare}% of them are in just three counties: ${listJoin(topCounties.map((c) => c.name))}.` : ''}` },
  ...(lead ? [{ q: `What is the most visited waterfall in ${state.name}?`, a: `By Google review count, <a href="${lead.url}">${lead.name}</a> in ${lead.county ? `${lead.county} County` : state.name} leads with ${fmtNum(lead.os.reviews)} reviews and a ${lead.os.rating.toFixed(1)} rating.${ins.mostReviewed[1] ? ` <a href="${ins.mostReviewed[1].url}">${ins.mostReviewed[1].name}</a> is next.` : ''}` }] : []),
  ...(content?.faqs || []),
  ...(ins.busiestTown && n > 3 ? [{ q: `Which ${state.name} town has the most waterfalls nearby?`, a: `<a href="${ins.busiestTown.url}">${ins.busiestTown.name}</a> has ${ins.busiestTown.nearby.filter((x) => x.miles <= 30).length} named waterfalls within 30 miles, the most of any town in our ${state.name} directory.` }] : []),
];
const schema = [
  { '@type': 'CollectionPage', name: title, url: `${SITE.url}${state.url}`, about: { '@type': isDC ? 'AdministrativeArea' : 'State', name: state.name }, description },
  { '@type': 'ItemList', name: `Waterfalls in ${state.name}`, numberOfItems: top.length, itemListElement: top.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${t.listing.url}`, name: t.listing.name })) },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) },
];
---
<Base title={title} description={description} image={image} imageAlt={photo.alt} breadcrumbs={crumbs} schema={schema} preloadImage={image}>
  <PageHero title={`Waterfalls in ${state.name}`} photo={photo} eyebrow={isDC ? 'District guide' : 'State guide'}>
    <p class="sub">{fmtNum(n)} waterfall{n === 1 ? '' : 's'} across {state.counties.length} count{state.counties.length === 1 ? 'y' : 'ies'}, ranked {ordinal(ins.rank)} nationally.{regions.length > 1 ? ` The main waterfall regions are ${listJoin(regions.map((r) => r.name))}.` : ''}</p>
    <p class="muted small">Source: USGS Geographic Names Information System, with visitor ratings from Google Maps listings.</p>
    {lists.length > 0 && <p class="li-actions">{lists.map((p, i) => <a class={i ? 'btn btn-outline' : 'btn btn-green'} href={p.url}>{p.short}</a>)}</p>}
  </PageHero>

  {chips.length > 1 && (
    <section class="wrap section-sm">
      <h2 class="sr-only">Towns</h2>
      <FilterChips chips={chips} label={`Waterfalls near ${state.name} towns`} />
    </section>
  )}

  {content && (
    <section class="wrap section-sm narrow prose" aria-labelledby="overview">
      <h2 id="overview">{n > 20 ? `Why ${state.name} Has So Many Waterfalls` : n > 3 ? `Where ${state.name}'s Waterfalls Are` : `Why ${state.name} Has So Few Waterfalls`}</h2>
      {content.overview.map((p) => <p>{p}</p>)}
    </section>
  )}


  {regions.length > 0 && (
    <section class="wrap section-sm" aria-labelledby="regions">
      <h2 id="regions">{state.name} Waterfall Regions</h2>
      <div class="grid-2">
        {regions.map((r) => (
          <article class="panel">
            <h3>{r.name}</h3>
            <p class="muted small">{r.listings.length} waterfall{r.listings.length === 1 ? '' : 's'} · {listJoin(r.counties.map((c) => `${c} County`))}</p>
            <p>{r.text}</p>
            {r.highlights.length > 0 && <p class="small"><strong>Start with:</strong> {r.highlights.map((l, i) => <>{i ? ', ' : ''}<a href={l.url}>{l.name}</a></>)}</p>}
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="wrap section-sm" aria-labelledby="top">
    <h2 id="top">{top.length === n ? `All ${n}` : `${top.length} Featured`} Waterfalls in {state.name}</h2>
    <p class="muted">Ordered by Google rating and review volume, then by documented USGS history.</p>
    <Listicle items={top} />
  </section>

  {(ins.topRated.length > 0 || tagLines.length > 0 || ins.extremes.length > 0) && (
    <section class="bg-mist section-sm">
      <div class="wrap grid-2">
        <div>
          {ins.topRated.length > 0 && (
            <>
              <h2>Highest Rated in {state.name}</h2>
              <ol class="ranked">
                {ins.topRated.map((l) => <li><a href={l.url}>{l.name}</a> <span class="muted small">{l.os.rating.toFixed(1)} from {fmtNum(l.os.reviews)} reviews · {l.city.name}</span></li>)}
              </ol>
              <p class="small muted">Waterfalls with at least 25 Google reviews.</p>
            </>
          )}
          {tagLines.length > 0 && (
            <>
              <h2>What Visitors Mention</h2>
              <ul>
                {tagLines.map((t) => <li>Reviews of {t.ls.length} {state.name} waterfall{t.ls.length === 1 ? '' : 's'} mention {t.label}, including {listJoin(t.ls.slice(0, 3).map((l) => l.name))}.</li>)}
              </ul>
            </>
          )}
        </div>
        <div>
          {ins.extremes.length > 0 && (
            <>
              <h2>{state.name} Waterfalls by the Compass</h2>
              <ul class="nearby-list">
                {ins.extremes.map((e) => <li><a href={e.l.url}><span><strong>{e.label}:</strong> {e.l.name}</span><span class="d">near {e.l.city.name}</span></a></li>)}
              </ul>
              <p class="small muted" style="margin-top:10px">The farthest-apart named falls in {state.name} are about {fmtMiles(ins.spanMiles).replace(' mi', ' miles')} apart.</p>
            </>
          )}
          {(ins.repeatedNames.length > 0 || ins.withVariants.length > 0 || ins.historyPick) && (
            <>
              <h2>Names and History</h2>
              {ins.repeatedNames.length > 0 && <p>The most reused names are {listJoin(ins.repeatedNames.map(([nm, c]) => `${nm} (${c})`))}, so check the county and town before you set out.</p>}
              {ins.withVariants.length > 0 && <p>{ins.withVariants.length} waterfall{ins.withVariants.length === 1 ? ' has' : 's have'} alternate historical names on record, such as {listJoin(ins.withVariants.slice(0, 2).map((l) => `${l.name} (also ${l.variants[0]})`))}.</p>}
              {ins.historyPick && <p>From the USGS record for <a href={ins.historyPick.url}>{ins.historyPick.name}</a>: "{ins.historyPick.gnisHistory}"</p>}
            </>
          )}
        </div>
      </div>
    </section>
  )}

  {content && (
    <section class="wrap section-sm grid-2">
      <div class="prose">
        <h2>Best Time to See Waterfalls in {state.name}</h2>
        <p>{content.bestTime}</p>
      </div>
      <div class="prose">
        <h2>Planning a Waterfall Trip in {state.name}</h2>
        <p>{content.planning}</p>
        <p class="small">More: <a href="/blog/waterfall-safety-tips">waterfall safety</a> · <a href="/blog/what-to-pack-for-a-waterfall-hike">packing list</a></p>
      </div>
    </section>
  )}

  <section class="bg-mist section-sm">
    <div class="wrap">
      <h2>Find Waterfalls Near a {state.name} Town</h2>
      <ul class="tile-list">
        {byCity.map((c) => <li><a href={c.url}><span>{c.name}</span><span class="count">{c.nearby.filter((x) => x.miles <= 30).length} nearby</span></a></li>)}
      </ul>
    </div>
  </section>

  {ins.counties.length > 0 && (
    <section class="wrap section-sm prose">
      <h2>Waterfalls by County</h2>
      <table>
        <thead><tr><th>County</th><th>Waterfalls</th><th>Share</th><th>Most visited</th></tr></thead>
        <tbody>
          {ins.counties.map((c) => <tr><td>{c.name}</td><td>{c.listings.length}</td><td>{c.share}%</td><td><a href={c.best.url}>{c.best.name}</a></td></tr>)}
        </tbody>
      </table>
    </section>
  )}

  <section class="wrap section-sm">
    <h2>All {state.name} Waterfalls A to Z</h2>
    <ul class="link-cols">
      {[...state.listings].sort((a, b) => a.name.localeCompare(b.name)).map((l) => <li><a href={l.url}>{l.name}</a> <span class="muted small">({l.city.name})</span></li>)}
    </ul>
  </section>

  <section class="wrap section narrow"><Faq faqs={faqs} heading={`${state.name} Waterfalls: FAQs`} /></section>
</Base>
