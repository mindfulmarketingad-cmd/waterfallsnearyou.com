---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getPosts } from '../../lib/blog.mjs';
import { getStateLists, getSmallest, getRoadside } from '../../lib/bestof.mjs';
const families = [
  ['best', 'Best Waterfalls by State', 'Ranked by visitor ratings and review volume.'],
  ['beautiful', 'Most Beautiful Waterfalls by State', 'Ranked by visitor photos, five-star reviews and scenery.'],
  ['must-see', 'Must-See Waterfalls by State', 'The five most visited falls in each state, with a route between them.'],
  ['hiking', 'Best Waterfall Hikes by State', 'Trail-reached falls ranked by the hikers who reviewed them.'],
  ['most-visited', 'Most Visited Waterfalls by State', 'The five busiest waterfalls in each state by Google review volume.'],
];
const smallest = getSmallest();
const roadside = getRoadside();
import Photo from '../../components/Photo.astro';
import { featuredPhoto } from '../../lib/photos.mjs';
import { imageFor } from '../../lib/core.mjs';
import { SITE } from '../../config.mjs';
const posts = getPosts();
const heroPhoto = featuredPhoto('/blog');
const image = heroPhoto.src;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }];
const schema = [
  { '@type': 'Blog', name: 'WaterfallsNearYou Blog', url: `${SITE.url}/blog`, blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: `${SITE.url}${p.url}`, datePublished: p.date.toISOString() })) },
];
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Waterfall Hiking Blog | Safety, Planning & Photography Tips" description="Practical guides for visiting waterfalls: safety rules, the best seasons for flow, photography tips, packing lists, family hikes and how to find waterfalls near you." image={image} breadcrumbs={crumbs} schema={schema} preloadImage={image}>
  <PageHero title="The Waterfall Blog" photo={heroPhoto} eyebrow="Guides and tips">
    <p class="sub">Field-tested advice for planning safer, better waterfall hikes, from reading a topo map to timing the season.</p>
  </PageHero>
  <section class="wrap section-sm">
    <div class="grid-3">
      {posts.map((p, i) => (
        <article class="card">
          <Photo photo={featuredPhoto(p.url)} eager={i < 3} />
          <div class="body">
            <span class="eyebrow">{p.category}</span>
            <h2 style="font-size:1.2rem;margin:0"><a href={p.url} style="color:inherit;text-decoration:none">{p.title}</a></h2>
            <p>{p.description}</p>
            <div class="meta"><time datetime={p.date.toISOString()}>{fmt(p.date)}</time> · {p.minutes} min read</div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="bg-mist section-sm">
    <div class="wrap">
      <span class="eyebrow">State guides</span>
      <h2>Waterfall Lists by State</h2>
      <p class="muted">Ranked lists for every state with more than 10 named waterfalls, updated for {new Date().getFullYear()}. Also see <a href={roadside.url}>{roadside.title}</a> and <a href={smallest.url}>{smallest.title}</a>.</p>
      {families.map(([kind, heading, blurb]) => (
        <>
          <h3 style="margin-top:28px">{heading}</h3>
          <p class="muted small">{blurb}</p>
          <ul class="tile-list">{getStateLists().filter((p) => p.kind === kind).map((p) => <li><a href={p.url}><span>{p.state.name}</span><span class="count">{p.items.length}</span></a></li>)}</ul>
        </>
      ))}
    </div>
  </section>
</Base>
