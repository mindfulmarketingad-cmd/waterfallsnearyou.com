---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import SearchForm from '../../components/SearchForm.astro';
import { getPosts } from '../../lib/blog.mjs';
import { imageFor, loadData } from '../../lib/core.mjs';
import { SITE } from '../../config.mjs';
import Photo from '../../components/Photo.astro';
import PageBand from '../../components/PageBand.astro';
import Byline from '../../components/Byline.astro';
import { featuredPhoto } from '../../lib/photos.mjs';

export function getStaticPaths() {
  return getPosts().map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
const posts = getPosts();
const post = posts.find((p) => p.slug === Astro.props.slug);
const related = posts.filter((p) => p !== post).sort((a, b) => (b.category === post.category) - (a.category === post.category)).slice(0, 3);
const topStates = [...loadData().states].sort((a, b) => b.listings.length - a.listings.length).slice(0, 8);
const photo = featuredPhoto(post.url);
const image = photo.src;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }, { name: post.title, url: post.url }];
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const schema = [
  {
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    image: image.startsWith('http') ? image : `${SITE.url}${image}`,
    datePublished: post.date.toISOString(),
    dateModified: post.updated.toISOString(),
    wordCount: post.words,
    articleSection: post.category,
    mainEntityOfPage: `${SITE.url}${post.url}`,
    author: { '@type': 'Organization', name: 'WaterfallsNearYou Editorial Team', url: `${SITE.url}/about` },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  ...(post.faqs.length ? [{ '@type': 'FAQPage', mainEntity: post.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base title={post.title} description={post.description} image={image} imageAlt={photo.alt} type="article" published={post.date.toISOString()} modified={post.updated.toISOString()} breadcrumbs={crumbs} bandCrumbs schema={schema} preloadImage={image}>
  <PageBand title={post.title} crumbs={crumbs} narrow />
  <article>
    <div class="wrap narrow">
      <figure class="post-hero">
        <img src={photo.src} alt={photo.alt} width="1200" height="630" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" onerror={photo.fallback ? `this.onerror=null;this.src='${photo.fallback}';this.parentNode.querySelector('figcaption')?.remove()` : undefined} />
        {photo.listing && <figcaption>Photo via Google: <a href={photo.listing.url}>{photo.listing.name}</a>, {photo.listing.state}, from our directory</figcaption>}
      </figure>
      <Byline published={post.date} updated={post.updated} minutes={post.minutes} />
      {post.headings.length > 2 && (
        <nav class="jump" aria-label="Jump to">
          <strong>Jump to:</strong>
          {post.headings.map((h, i) => <>{i ? <span class="sep">·</span> : ''}<a href={`#${h.id}`}>{h.text}</a></>)}
        </nav>
      )}
      <p class="lead">{post.description}</p>
      <div class="prose" set:html={post.html} />
      {post.faqs.length > 0 && <div style="margin-top:40px"><Faq faqs={post.faqs} heading="Frequently asked questions" /></div>}
      <div class="panel" style="margin:40px 0">
        <h2>Find Waterfalls Near You</h2>
        <p>Search 2,500+ named waterfalls by name, town or state.</p>
        <SearchForm bordered id="blog-q" />
        <p class="small" style="margin-top:14px">Popular states: {topStates.map((s, i) => <>{i ? ' · ' : ''}<a href={s.url}>{s.name}</a></>)}</p>
      </div>
    </div>
  </article>
  <section class="bg-mist section-sm">
    <div class="wrap">
      <h2>Keep Reading</h2>
      <div class="grid-3">
        {related.map((p) => (
          <article class="card">
            <Photo photo={featuredPhoto(p.url)} />
            <div class="body"><span class="eyebrow">{p.category}</span><h3><a href={p.url}>{p.title}</a></h3><p>{p.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
