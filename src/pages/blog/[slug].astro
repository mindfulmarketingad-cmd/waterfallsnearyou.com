---
// Hand-written guides in src/content/blog. Templated "before you visit" posts are not built;
// their old URLs 301 to the waterfall page or the state list.
import ArticlePost from '../../components/ArticlePost.astro';
import { getPosts } from '../../lib/blog.mjs';

export function getStaticPaths() {
  return getPosts().map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
const { slug } = Astro.props;
---
<ArticlePost slug={slug} />
