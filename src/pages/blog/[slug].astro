---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import SearchForm from '../../components/SearchForm.astro';
import { getPosts } from '../../lib/blog.mjs';
import { imageFor, loadData } from '../../lib/core.mjs';
import { SITE } from '../../config.mjs';

export function getStaticPaths() {
  return getPosts().map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
const posts = getPosts();
const post = posts.find((p) => p.slug === Astro.props.slug);
const related = posts.filter((p) => p !== post).sort((a, b) => (b.category === post.category) - (a.category === post.category)).slice(0, 3);
const topStates = [...loadData().states].sort((a, b) => b.listings.length - a.listings.length).slice(0, 8);
const image = imageFor(post.url);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }, { name: post.title, url: post.url }];
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const schema = [
  {
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    image: `${SITE.url}${image}`,
    datePublished: post.date.toISOString(),
    dateModified: post.updated.toISOString(),
    wordCount: post.words,
    articleSection: post.category,
    mainEntityOfPage: `${SITE.url}${post.url}`,
    author: { '@type': 'Organization', name: 'WaterfallsNearYou Editorial Team', url: `${SITE.url}/about` },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  ...(post.faqs.length ? [{ '@type': 'FAQPage', mainEntity: post.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base title={post.title} description={post.description} image={image} imageAlt={post.imageAlt} type="article" published={post.date.toISOString()} modified={post.updated.toISOString()} breadcrumbs={crumbs} schema={schema} preloadImage={image}>
  <article>
    <header class="wrap narrow" style="padding-top:22px">
      <span class="eyebrow">{post.category}</span>
      <h1>{post.title}</h1>
      <p class="lead">{post.description}</p>
      <p class="muted small">By the WaterfallsNearYou Editorial Team · <time datetime={post.date.toISOString()}>{fmt(post.date)}</time> · {post.minutes} min read</p>
      <img class="feature" src={image} alt={post.imageAlt} width="1200" height="630" fetchpriority="high" style="border-radius:14px;margin:18px 0 8px;aspect-ratio:1200/630;width:100%" />
    </header>
    <div class="wrap narrow">
      {post.headings.length > 2 && (
        <nav class="panel" aria-label="Table of contents" style="margin:20px 0">
          <h2 style="font-size:1.05rem">In this guide</h2>
          <ol style="margin:0;padding-left:1.2em">{post.headings.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose" set:html={post.html} />
      {post.faqs.length > 0 && <div style="margin-top:40px"><Faq faqs={post.faqs} /></div>}
      <div class="panel" style="margin:40px 0">
        <h2>Find Waterfalls Near You</h2>
        <p>Search 2,500+ named waterfalls by name, town or state.</p>
        <SearchForm bordered id="blog-q" />
        <p class="small" style="margin-top:14px">Popular states: {topStates.map((s, i) => <>{i ? ' · ' : ''}<a href={s.url}>{s.name}</a></>)}</p>
      </div>
    </div>
  </article>
  <section class="bg-mist section-sm">
    <div class="wrap">
      <h2>Keep Reading</h2>
      <div class="grid-3">
        {related.map((p) => (
          <article class="card">
            <img src={imageFor(p.url)} alt={p.imageAlt} width="1200" height="630" loading="lazy" />
            <div class="body"><span class="eyebrow">{p.category}</span><h3><a href={p.url}>{p.title}</a></h3><p>{p.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
