---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import Photo from '../../components/Photo.astro';
import { getRoadside, BEST_YEAR } from '../../lib/bestof.mjs';
import { pagePhoto, listingPhoto } from '../../lib/photos.mjs';
import { directionsUrl, fmtNum, stars, listJoin, displayName } from '../../lib/format.mjs';
import { SITE } from '../../config.mjs';

const post = getRoadside();
const { items } = post;
const photo = pagePhoto(post.url, items.map((i) => i.listing));
const updated = new Date();
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }, { name: 'Waterfalls with Easy Roadside Access', url: post.url }];
const faqs = [
  { q: 'What waterfalls can you see without hiking?', a: `Our top picks are ${listJoin(items.slice(0, 3).map((i) => `<a href="${i.listing.url}">${i.listing.name}</a> in ${i.listing.state}`))}. Each one has a roadside viewpoint, a paved path, a boardwalk or a short walk from parking, based on its listing and visitor reviews.` },
  { q: 'Are these waterfalls wheelchair accessible?', a: 'Not necessarily. Easy access means a short or paved route, but several include stairs, slopes or uneven ground. Check the listing details and the land manager before visiting with a wheelchair or stroller.' },
  { q: 'How did you choose these waterfalls?', a: `We looked for listings or Google reviews that describe roadside viewing, paved paths, boardwalks, easy walks or access from the parking lot, excluded any described as a hike or flagged as steep, and required a rating of at least 4.3 stars. ${post.candidates} waterfalls qualified; these are the highest rated by a weighted score.` },
  { q: 'When are roadside waterfalls least crowded?', a: 'Early mornings on weekdays. Short-walk waterfalls fill up quickly on summer weekends and holidays because they suit every age and fitness level.' },
];
const schema = [
  { '@type': 'BlogPosting', headline: post.title, description: post.description, image: photo.src, datePublished: `${BEST_YEAR}-10-02T00:00:00.000Z`, dateModified: updated.toISOString(), mainEntityOfPage: `${SITE.url}${post.url}`, author: { '@type': 'Organization', name: 'WaterfallsNearYou Editorial Team', url: `${SITE.url}/about` }, publisher: { '@id': `${SITE.url}/#organization` } },
  { '@type': 'ItemList', name: post.title, numberOfItems: items.length, itemListElement: items.map((i, n) => ({ '@type': 'ListItem', position: n + 1, url: `${SITE.url}${i.listing.url}`, name: i.listing.name })) },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) },
];
---
<Base title={post.title} description={post.description} image={photo.src} imageAlt={photo.alt} type="article" modified={updated.toISOString()} breadcrumbs={crumbs} schema={schema} preloadImage={photo.src}>
  <article>
    <header class="wrap narrow" style="padding-top:22px">
      <span class="eyebrow">Easy access · Updated {updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</span>
      <h1>{post.title}</h1>
      <p class="lead">Not every great waterfall needs a long hike. These {items.length} top-rated falls across {post.states.length} states can be seen from a roadside viewpoint, a paved path, a boardwalk or a short walk from the parking area, which makes them ideal for families, older visitors and quick stops on a road trip.</p>
      <div style="margin:18px 0 8px"><Photo photo={photo} class="feature" priority /></div>
    </header>
    <div class="wrap narrow">
      <div class="prose">
        <h2>How We Picked</h2>
        <p>We only included waterfalls whose Google listing or reviews explicitly describe easy access, such as roadside viewing, paved trails, boardwalks or "accessible from the parking lot". Anything described as a hike, or tagged by reviewers as steep or strenuous, was left out. From the {post.candidates} that qualified, we ranked by a weighted Google rating. Access can change with weather and repairs, so check conditions before you go.</p>
        <table>
          <thead><tr><th>#</th><th>Waterfall</th><th>State</th><th>Rating</th></tr></thead>
          <tbody>{items.map((i, n) => <tr><td>{n + 1}</td><td><a href={i.listing.url}>{displayName(i.listing)}</a></td><td><a href={`/states/${i.listing.stateSlug}`}>{i.listing.state}</a></td><td>{i.listing.os.rating.toFixed(1)} ({fmtNum(i.listing.os.reviews)})</td></tr>)}</tbody>
        </table>
      </div>
      <ol class="best-list">
        {items.map(({ listing: l, why }, n) => (
          <li id={`w${n + 1}`}>
            <h2><span class="best-num">{n + 1}.</span> <a href={l.url}>{displayName(l)}</a>, {l.state}</h2>
            <p class="muted small">{l.county ? `${l.county} County · ` : ''}near {l.city.name}</p>
            <Photo photo={listingPhoto(l)} eager={n < 2} />
            <p class="rating"><span class="stars" aria-hidden="true">{stars(l.os.rating)}</span>{l.os.rating.toFixed(1)} <span class="count">({fmtNum(l.os.reviews)} Google reviews)</span></p>
            <p>{why.join(' ')}</p>
            <div class="li-actions">
              <a class="btn btn-primary" href={l.url}>Full details and map</a>
              <a class="btn btn-outline" href={directionsUrl(l)} rel="nofollow noopener" target="_blank"><Icon name="route" />Directions</a>
              <a class="btn btn-outline" href={l.city.url}>Waterfalls near {l.city.name}</a>
            </div>
          </li>
        ))}
      </ol>
      <div class="prose">
        <h2>Tips for Easy Waterfall Visits</h2>
        <ul>
          <li>Stay behind railings and on viewing platforms. Short trails still end at slick rock and steep drops; see our <a href="/blog/waterfall-safety-tips">waterfall safety tips</a>.</li>
          <li>Visit after a few days of rain for the strongest flow; our guide to <a href="/blog/best-time-to-visit-waterfalls">the best time to visit waterfalls</a> explains why.</li>
          <li>Bringing children? Read <a href="/blog/waterfall-hikes-with-kids">waterfall hikes with kids</a> for age-by-age advice.</li>
        </ul>
      </div>
      <div style="margin:36px 0"><Faq faqs={faqs} /></div>
    </div>
  </article>
</Base>

<style>
  .best-list { list-style: none; padding: 0; margin: 28px 0; display: flex; flex-direction: column; gap: 40px; }
  .best-list h2 { margin: 0 0 4px; }
  .best-list h2 a { color: var(--slate-dark); text-decoration: none; }
  .best-num { color: var(--forest); }
  .best-list img { border-radius: var(--radius); aspect-ratio: 1200 / 630; object-fit: cover; width: 100%; margin: 12px 0; background: var(--mist); }
</style>
