---
// Compact numbered listing card used on state pages. Data attributes drive the client-side
// search, filters, sorting, distance and map view.
import { listingPhoto, sized } from '../lib/photos.mjs';
import { stars, fmtNum, addressText, hoursSummary, directionsUrl, countyUrl, ratingsUrl, mapUrl } from '../lib/format.mjs';
import { features, perfectFor, cardSummary, FEATURES } from '../lib/cards.mjs';
interface Props { listing: any; rank: number }
const { listing: l, rank } = Astro.props;
const photo = listingPhoto(l);
const thumb = sized(photo.src, 240, 160);
const feats = features(l);
const hours = hoursSummary(l.os);
const tags = (l.os?.reviewTags || []).slice(0, 4);
const onerror = photo.fallback ? `this.onerror=null;this.src='${photo.fallback}'` : undefined;
---
<li
  class="sc"
  id={`w-${l.slug}`}
  data-name={l.name.toLowerCase()}
  data-town={l.city.name}
  data-county={l.county || ''}
  data-rating={l.os?.rating || 0}
  data-reviews={l.os?.reviews || 0}
  data-score={l.score.toFixed(3)}
  data-lat={l.lat.toFixed(5)}
  data-lng={l.lng.toFixed(5)}
  data-features={feats.join(' ')}
  data-url={l.url}
>
  <span class="sc-num" aria-hidden="true">{rank}</span>
  <a class="sc-thumb" href={l.url} tabindex="-1" aria-hidden="true">
    <img src={thumb} alt="" width="120" height="80" loading={rank <= 4 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" onerror={onerror} />
  </a>
  <div class="sc-body">
    <h3 class="sc-name"><a href={l.url}>{l.name}</a></h3>
    <p class="sc-meta">
      {l.os?.rating ? (
        <a class="sc-rating" href={ratingsUrl(l)}><span class="stars" aria-hidden="true">{stars(l.os.rating)}</span> <strong>{l.os.rating.toFixed(1)}</strong> <span class="muted">{fmtNum(l.os.reviews)} review{l.os.reviews === 1 ? '' : 's'}</span></a>
      ) : (
        <span class="sc-rating unrated"><span class="stars empty" aria-hidden="true">☆☆☆☆☆</span> <span class="muted">Not yet rated</span></span>
      )}
      <span class="sep">·</span>
      <a href={l.city.url}>{l.city.name}</a>
      {l.county && <><span class="sep">·</span><a href={countyUrl(l)}>{l.county} County</a></>}
      <span class="sc-dist" hidden></span>
    </p>
    <p class="sc-line"><a href={mapUrl(l)}>{addressText(l)}</a></p>
    <p class="sc-line sc-links">
      {l.os?.phone && <><a href={`tel:${l.os.phone.replace(/[^\d+]/g, '')}`}>{l.os.phone}</a><span class="sep">·</span></>}
      {l.os?.site && <><a href={l.os.site} rel="nofollow noopener ugc" target="_blank">Visit website</a><span class="sep">·</span></>}
      {l.os?.photosCount > 0 && l.os.locationLink && <><a href={l.os.locationLink} rel="nofollow noopener" target="_blank">Photos ({fmtNum(l.os.photosCount)})</a><span class="sep">·</span></>}
      <a href={directionsUrl(l)} rel="nofollow noopener" target="_blank">Directions</a>
    </p>
    <p class:list={['sc-hours', { open: hours }]}>{hours || 'Hours not listed. Confirm before you go.'}</p>
    <p class="sc-perfect">{perfectFor(l, feats)}</p>
    <p class="sc-sum">{cardSummary(l, rank)}</p>
    {(tags.length > 0 || feats.length > 0) && (
      <p class="sc-tags">
        {feats.filter((f) => f !== 'top').slice(0, 2).map((f) => <a class="sc-tag" href={`?feature=${f}#waterfalls`} data-feature={f}>{FEATURES[f]}</a>)}
        {tags.map((t) => <span class="sc-tag plain">{t}</span>)}
      </p>
    )}
  </div>
</li>
