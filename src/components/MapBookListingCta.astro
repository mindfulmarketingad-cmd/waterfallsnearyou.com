---
// Inline checkout button for a waterfall listing's top action row, beside
// Get directions. No price is shown; Stripe Checkout does that. States
// without an available book render nothing.
import { bookBySlug } from '../lib/map-books.mjs';

interface Props {
  stateSlug: string;
}
const { stateSlug } = Astro.props;
const book = bookBySlug(stateSlug);
---
{book?.available && (
  <form method="post" action="/api/maps/checkout" data-map-form class="map-pdf-form">
    <input type="hidden" name="state" value={book.slug} />
    <button class="btn btn-outline" type="submit">Download map PDF</button>
    <p class="map-pdf-status" data-map-status role="status" hidden></p>
  </form>
)}

<script>
  import { bindMapCheckout } from '../scripts/map-book-checkout.js';
  bindMapCheckout();
</script>

<style>
  .map-pdf-form { display: contents; }
  .map-pdf-status { flex-basis: 100%; margin: 0; font-size: 0.85rem; color: var(--slate); }
</style>
