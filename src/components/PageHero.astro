---
import Photo from './Photo.astro';
interface Props { title: string; photo: { src: string; alt: string; caption?: string | null; fallback?: string | null }; eyebrow?: string }
const { title, photo, eyebrow } = Astro.props;
---
<section class="page-hero">
  <div class="wrap grid">
    <div>
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      <slot />
    </div>
    <Photo photo={photo} class="feature" priority />
  </div>
</section>
