---
// Interactive waterfall map (MapLibre GL + OpenFreeMap tiles). Points are embedded as JSON; every
// marker opens a popup linking to that waterfall's listing page.
interface Point { n: string; u: string; la: number; ln: number; t: string; r?: number; c?: number }
interface Props { points: Point[]; label: string; bounds?: [[number, number], [number, number]]; height?: number }
const { points, label, bounds, height = 640 } = Astro.props;
// MapLibre bounds are [[west, south], [east, north]] in lng/lat order.
const lngLatBounds = bounds ? [[bounds[0][1], bounds[0][0]], [bounds[1][1], bounds[1][0]]] : null;
const data = JSON.stringify({ points, bounds: lngLatBounds }).replace(/</g, '\\u003c');
---
<div class="wmap-wrap">
  <div class="wmap" style={`--h:${height}px`} role="region" aria-label={label}></div>
  <p class="wmap-legend small muted"><span class="dot"></span> Waterfall with visitor ratings <span class="dot dot-u"></span> Not yet rated · Tap a marker for the waterfall page. Use two fingers (or Ctrl + scroll) to zoom.</p>
  <noscript><p>The interactive map needs JavaScript. Browse the waterfall pages linked below instead.</p></noscript>
  <script type="application/json" class="wmap-data" set:html={data} />
</div>

<style>
  .wmap { height: var(--h); max-height: 75vh; min-height: 380px; border: 1px solid var(--line); border-radius: 12px; background: var(--mist); overflow: hidden; }
  .wmap-legend { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin: 8px 0 0; }
  .dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: #3f6f5a; border: 2px solid #fff; box-shadow: 0 0 0 1px #3f6f5a; }
  .dot-u { background: #9aa6a1; box-shadow: 0 0 0 1px #9aa6a1; margin-left: 10px; }
</style>

<script>
  import { createWaterfallMap } from '../scripts/wmap.js';
  for (const wrap of document.querySelectorAll<HTMLElement>('.wmap-wrap')) {
    const el = wrap.querySelector('.wmap') as HTMLElement;
    const { points, bounds } = JSON.parse(wrap.querySelector('.wmap-data').textContent);
    createWaterfallMap(el, points, { bounds: bounds || undefined, padding: 20 }).catch(() => {});
  }
</script>
