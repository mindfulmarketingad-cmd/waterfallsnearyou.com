---
interface Props { faqs: { q: string; a: string }[]; heading?: string; id?: string }
const { faqs, heading = 'Frequently Asked Questions', id = 'faq' } = Astro.props;
---
{faqs.length > 0 && (
  <section aria-labelledby={id}>
    <h2 id={id}>{heading}</h2>
    <div class="faq">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <div class="a"><p set:html={f.a} /></div>
        </details>
      ))}
    </div>
  </section>
)}
