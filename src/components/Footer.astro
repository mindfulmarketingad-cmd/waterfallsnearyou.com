---
import { SITE } from '../config.mjs';
const year = new Date().getFullYear();
const links = [
  ['/', 'Home'], ['/about', 'About'], ['/contact', 'Contact'], ['/disclaimer', 'Disclaimer'],
  ['/privacy', 'Privacy'], ['/terms', 'Terms'], ['/sitemap', 'Sitemap'],
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-top">
      <a href="/" aria-label="WaterfallsNearYou home"><img src="/brand/logo-white.svg" alt="WaterfallsNearYou" width="251" height="36" loading="lazy" /></a>
      <nav aria-label="Footer">
        <ul class="foot-links">
          {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <ul class="social" aria-label="Social media">
        <li><a href={SITE.social.instagram} rel="noopener me" target="_blank" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3c1.2-.1 1.6-.1 4.8-.1ZM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.2 4.4 2.6 6.8 7 7 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.2-4.4-2.6-6.8-7-7C15.7 0 15.3 0 12 0Zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9Z"/></svg></a></li>
        <li><a href={SITE.social.twitter} rel="noopener me" target="_blank" aria-label="X (Twitter)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.2 2.3h3.4l-7.4 8.4L23 21.7h-6.8l-5.3-7-6.1 7H1.4l7.9-9L.9 2.3h7l4.8 6.4 5.5-6.4Zm-1.2 17.4h1.9L7 4.2H5l12 15.5Z"/></svg></a></li>
        <li><a href={SITE.social.facebook} rel="noopener me" target="_blank" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4h-3V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12Z"/></svg></a></li>
      </ul>
    </div>
    <div class="foot-bottom">
      <p>&copy; {year} {SITE.domain}. All rights reserved.</p>
      <p>Waterfall locations: <a href="https://www.usgs.gov/us-board-on-geographic-names/domestic-names" rel="noopener" target="_blank">USGS GNIS</a> (public domain). Towns: <a href="https://www.geonames.org/" rel="noopener" target="_blank">GeoNames</a> (CC BY 4.0).</p>
    </div>
  </div>
</footer>
