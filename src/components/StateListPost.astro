---
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import PageBand from './PageBand.astro';
import Byline from './Byline.astro';
import PostCard from './PostCard.astro';
import { getStateLists, listsForState, BEST_YEAR, LISTS_PUBLISHED } from '../lib/bestof.mjs';
import { displayName, fmtNum, fmtMiles, listJoin } from '../lib/format.mjs';
import { cardSummary } from '../lib/cards.mjs';
import { pagePhoto } from '../lib/photos.mjs';
import { SITE } from '../config.mjs';

interface Props { url: string }
const post = getStateLists().find((p) => p.url === Astro.props.url);
const { state, items, content } = post;
const photo = pagePhoto(post.url, items.map((i) => i.listing));
const image = photo.src;
const abs = (u) => (u.startsWith('http') ? u : `${SITE.url}${u}`);
const updated = new Date();
const published = LISTS_PUBLISHED;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }, { name: post.title.replace(/ \(\d{4}( Updated)?\)$/, ''), url: post.url }];
const first = items[0].listing;
const towns = [...new Set(items.map((i) => i.listing.city))].slice(0, 6);
const siblings = listsForState(state).filter((p) => p !== post);
const label = { best: 'best', beautiful: 'most beautiful', 'must-see': 'must-see', hiking: 'best hiking', 'most-visited': 'most visited' }[post.kind];
const words = items.reduce((s, i) => s + i.why.join(' ').split(/\s+/).length + 40, 350);
const minutes = Math.max(2, Math.round(words / 230));
const lead = {
  best: `The ${label} waterfall${items.length > 1 ? 's' : ''} in ${state.name} ${items.length > 1 ? 'are' : 'is'} ${items.length > 3 ? `${items.slice(0, 3).map((i) => displayName(i.listing)).join(', ')} and ${items.length - 3} more` : listJoin(items.map((i) => displayName(i.listing)))}, ranked by rating and review volume from the ${fmtNum(state.listings.length)} waterfalls we track in the state.`,
  beautiful: `Ranked by what visitors photograph and rate five stars, these are the ${items.length} most beautiful of the ${fmtNum(state.listings.length)} waterfalls we track in ${state.name}, starting with ${displayName(first)}.`,
  'must-see': `If you only have time for five ${state.name} waterfalls, make it these: consistently top-rated, widely visited falls, spread out so the list covers ${post.regionsUsed.length > 1 ? `the ${listJoin(post.regionsUsed.slice(0, 3))}` : 'more of the state'}.`,
  'most-visited': `These are the ${state.name} waterfalls that draw the biggest crowds, measured by Google review volume and led by ${displayName(first)}. Popular does not have to mean packed if you time it right.`,
  hiking: `These ${items.length} ${state.name} waterfalls are reached on foot and rated highly by the people who hiked them, led by ${listJoin(items.slice(0, 3).map((i) => displayName(i.listing)))}.`,
}[post.kind];
const faqs = [
  { q: `What is the ${label === 'must-see' ? 'number one must-see' : label} waterfall in ${state.name}?`, a: `${first.name} tops our ${BEST_YEAR} list${first.os?.rating ? `, with a ${first.os.rating.toFixed(1)}-star rating from ${fmtNum(first.os.reviews)} Google reviews` : ''}. It is near <a href="${first.city.url}">${first.city.name}</a>${first.county ? ` in ${first.county} County` : ''}.` },
  { q: `How was this list made?`, a: post.method },
  ...(post.route ? [{ q: `Can you see all five in one trip?`, a: `The five are about ${Math.round(post.route.total)} straight-line miles apart in total when visited in the order suggested above. Most people split them across two or more days.` }] : []),
  { q: `How many waterfalls are in ${state.name}?`, a: `Our directory lists ${fmtNum(state.listings.length)} waterfalls in ${state.name}. See every one, with filters and a map, on the <a href="${state.url}">${state.name} waterfalls page</a>.` },
  ...(content?.faqs?.slice(post.kind === 'best' ? 0 : 1, post.kind === 'best' ? 1 : 2) || []),
];
const schema = [
  {
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    image: abs(image),
    datePublished: published.toISOString(),
    dateModified: updated.toISOString(),
    mainEntityOfPage: `${SITE.url}${post.url}`,
    author: { '@type': 'Organization', name: 'WaterfallsNearYou Editorial Team', url: `${SITE.url}/about` },
    publisher: { '@id': `${SITE.url}/#organization` },
    about: { '@type': 'State', name: state.name },
  },
  { '@type': 'ItemList', name: post.title, numberOfItems: items.length, itemListElement: items.map((i, n) => ({ '@type': 'ListItem', position: n + 1, url: `${SITE.url}${i.listing.url}`, name: i.listing.name })) },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) },
];
---
<Base title={post.title} description={post.description} image={image} imageAlt={photo.alt} type="article" published={published.toISOString()} modified={updated.toISOString()} breadcrumbs={crumbs} bandCrumbs schema={schema} preloadImage={image}>
  <PageBand title={post.title} crumbs={crumbs} narrow />
  <article class="wrap narrow">
    <figure class="post-hero">
      <img src={photo.src} alt={photo.alt} width="1200" height="630" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" onerror={photo.fallback ? `this.onerror=null;this.src='${photo.fallback}';this.parentNode.querySelector('figcaption')?.remove()` : undefined} />
      {photo.listing && <figcaption>Photo via Google: {photo.listing.name}, {photo.listing.state}, from our directory</figcaption>}
    </figure>
    <Byline published={published} updated={updated} minutes={minutes} />

    <nav class="jump" aria-label="Jump to">
      <strong>Jump to:</strong>
      {items.map((i, n) => <>{n ? <span class="sep">·</span> : ''}<a href={`#w${n + 1}`}>{n + 1}. {displayName(i.listing)}</a></>)}
    </nav>

    <div class="prose">
      <p>{lead}</p>
      <p>
        For every waterfall we track nearby, see the full list of <a href={state.url}>waterfalls in {state.name}</a>{towns.length > 0 && <>, or browse by town: {towns.map((c, i) => <>{i ? ', ' : ''}<a href={c.url}>{c.name}</a></>)}</>}.
        {siblings.length > 0 && <> You can also compare our {siblings.slice(0, 2).map((p, i) => <>{i ? ' and ' : ''}<a href={p.url}>{p.short.toLowerCase()} in {state.name}</a></>)}.</>}
      </p>
      <p class="small muted">How we picked: {post.method}</p>
    </div>

    <ol class="pc-list" style="margin:22px 0 10px">
      {items.map(({ listing: l, why }, n) => (
        <PostCard listing={l} rank={n + 1} lead={cardSummary(l, n + 1)} why={why} anchor={`w${n + 1}`} />
      ))}
    </ol>

    {post.route && (
      <div class="prose">
        <h2>A Route Linking All Five</h2>
        <p>Starting from the northernmost pick and always heading to the nearest remaining one, the five cover about {Math.round(post.route.total)} straight-line miles. Road distances are longer.</p>
        <ol>
          <li><a href={post.route.legs[0].from.url}>{post.route.legs[0].from.name}</a> (start, near <a href={post.route.legs[0].from.city.url}>{post.route.legs[0].from.city.name}</a>)</li>
          {post.route.legs.map((g) => <li><a href={g.to.url}>{g.to.name}</a>, about {fmtMiles(g.miles)} {g.dir}</li>)}
        </ol>
      </div>
    )}

    <div style="margin:34px 0"><Faq faqs={faqs} heading="Frequently asked questions" /></div>

    <div class="prose">
      <h2>Summary</h2>
      <p>
        {displayName(first)} near {first.city.name} is our top pick for {label} waterfalls in {state.name}{first.os?.rating ? `, rated ${first.os.rating.toFixed(1)} out of 5 from ${fmtNum(first.os.reviews)} reviews` : ''}.
        Ratings and review counts reflect public data at the time of writing and can change, and trail access, water levels and road conditions vary through the year, so confirm current conditions before you drive out.
      </p>
      {content?.bestTime && <p>{content.bestTime}</p>}
      <p>
        For more options, see every waterfall on the <a href={state.url}>{state.name} waterfalls page</a>{siblings[0] && <>, read <a href={siblings[0].url}>{siblings[0].title.replace(/ \(\d{4}( Updated)?\)$/, '')}</a></>}, or check our <a href="/blog/waterfall-safety-tips">waterfall safety tips</a> before you go.
      </p>
    </div>

  </article>
</Base>
