---
// Waterfalls to pair with the color: the Census state outline with the itinerary highlighted.
// The wide foliage map itself is FoliageViewer, at the top of the page.
import StateWaterfallMap from './StateWaterfallMap.astro';

interface Props {
  slug: string;
  name: string;
  featuredUrls?: string[];
  mapHref?: string | null;
}
const { slug, name, featuredUrls = [], mapHref = null } = Astro.props;
---
<section class="foliage-state-map" id="fall-foliage-falls" aria-labelledby="foliage-falls-map-h">
  <StateWaterfallMap
    slug={slug}
    name={name}
    featuredUrls={featuredUrls}
    level="h2"
    mapHref={mapHref}
    headingId="foliage-falls-map-h"
  />
</section>
