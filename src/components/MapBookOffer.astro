---
import { DOWNLOAD_WINDOW_DAYS, formatSizeMB, previewPublicPath } from '../lib/map-books.mjs';

interface Props {
  book: {
    slug: string;
    name: string;
    pages: number;
    falls: number;
    areaMaps: number;
    featuredPage?: string | null;
    sizeMB?: number | null;
  };
  showStateLink?: boolean;
  showHubLink?: boolean;
  anchor?: string;
}
const { book, showStateLink = false, showHubLink = true, anchor = 'map-book' } = Astro.props;
const preview = previewPublicPath(book.slug);
const size = formatSizeMB(book.sizeMB);
const title = `Download the ${book.name} Waterfall Map Book`;
const mapsLabel = book.areaMaps === 1 ? 'map shows' : 'maps showing';
---
<section class="wrap section-sm" id={anchor} aria-labelledby={`${anchor}-h`}>
  <div class="map-book">
    <div class="map-book-preview">
      {preview ? (
        <img src={preview} alt={`Page 1 of the ${book.name} waterfall map book`} width="600" height="800" loading="lazy" />
      ) : (
        <div class="map-book-placeholder" role="img" aria-label={`${book.name} map book preview is not on the site yet`}>
          <span>A page-1 preview will be added with the file.</span>
        </div>
      )}
    </div>
    <div>
      <p class="eyebrow">Printable map book</p>
      <h2 id={`${anchor}-h`}>{title}</h2>
      <p>A printable PDF, ready to use offline. This book is {book.pages} pages and covers {book.falls} falls. The waterfall pages on this site stay free.</p>
      <ul>
        <li>Statewide overview</li>
        <li>{book.areaMaps} trail-scale area {mapsLabel} trails, trailheads, parking, terrain and contours</li>
        {book.featuredPage && <li>A featured {book.featuredPage} page</li>}
        <li>An index with heights, hikes and GPS</li>
      </ul>
      {size && <p class="muted small">{size}.</p>}
      <form method="post" action="/api/maps/checkout" data-map-form>
        <input type="hidden" name="state" value={book.slug} />
        <button class="btn btn-green" type="submit">Download</button>
        <p class="map-book-status muted small" data-map-status role="status" hidden></p>
      </form>
      <p class="muted small">Checkout collects an email for the receipt. The download link on the next page works for {DOWNLOAD_WINDOW_DAYS} days. Card details stay with Stripe.</p>
      {showStateLink && <p class="small"><a href={`/states/${book.slug}`}>The {book.name} waterfall guide</a> stays free. This PDF is separate.</p>}
      {showHubLink && <p class="small"><a href="/maps">All waterfall map books</a></p>}
    </div>
  </div>
</section>

<script>
  import { bindMapCheckout } from '../scripts/map-book-checkout.js';
  bindMapCheckout();
</script>

<style>
  .map-book {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 20px;
  }
  .map-book-preview img,
  .map-book-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 8px;
    background: var(--mist);
    border: 1px solid var(--line);
  }
  .map-book-preview img { object-fit: cover; }
  .map-book-placeholder {
    display: grid;
    place-items: center;
    padding: 16px;
    text-align: center;
    color: var(--slate-soft);
    font-size: 0.9rem;
  }
  .map-book ul { margin: 0.4em 0 0.8em; padding-left: 1.2em; }
  .map-book li { margin: 0.2em 0; }
  .map-book .btn { margin-top: 4px; }
  .map-book-status { margin-top: 8px; }
  @media (max-width: 720px) {
    .map-book { grid-template-columns: 1fr; }
    .map-book-preview { max-width: 220px; }
  }
</style>
