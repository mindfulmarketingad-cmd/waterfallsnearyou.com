---
import { DOWNLOAD_WINDOW_DAYS, MAP_BOOK_PRICE_LABEL, formatSizeMB, previewPublicPath } from '../lib/map-books.mjs';

interface Props {
  book: {
    slug: string;
    name: string;
    pages: number;
    falls: number;
    areaMaps: number;
    featuredPage?: string | null;
    sizeMB?: number | null;
  };
  showStateLink?: boolean;
  showHubLink?: boolean;
  anchor?: string;
}
const { book, showStateLink = false, showHubLink = true, anchor = 'map-book' } = Astro.props;
const preview = previewPublicPath(book.slug);
const size = formatSizeMB(book.sizeMB);
const title = `Download the ${book.name} Waterfall Map Book (${MAP_BOOK_PRICE_LABEL})`;
const mapsLabel = book.areaMaps === 1 ? 'map' : 'maps';
---
<section class="wrap section-sm" id={anchor} aria-labelledby={`${anchor}-h`}>
  <div class="map-book">
    <div class="map-book-preview">
      {preview ? (
        <img src={preview} alt={`Page 1 of the ${book.name} waterfall map book`} width="600" height="800" loading="lazy" />
      ) : (
        <div class="map-book-placeholder" role="img" aria-label={`${book.name} map book preview is not on the site yet`}>
          <span>A page-1 preview will be added with the file.</span>
        </div>
      )}
    </div>
    <div>
      <p class="eyebrow">Printable map book</p>
      <h2 id={`${anchor}-h`}>{title}</h2>
      <p>A PDF you can print or save. One payment of {MAP_BOOK_PRICE_LABEL}. The waterfall pages on this site stay free.</p>
      <ul>
        <li>Statewide overview</li>
        <li>{book.areaMaps} detailed trail-scale area {mapsLabel} with trails, trailheads, parking, terrain and contours</li>
        {book.featuredPage && <li>A featured {book.featuredPage} page</li>}
        <li>An index with heights, hikes and GPS</li>
      </ul>
      <p class="muted small">{book.pages} pages, covering {book.falls} falls.{size ? ` ${size}.` : ''}</p>
      <form method="post" action="/api/maps/checkout" data-map-form>
        <input type="hidden" name="state" value={book.slug} />
        <button class="btn btn-green" type="submit">{title}</button>
        <p class="map-book-status muted small" data-map-status role="status" hidden></p>
      </form>
      <p class="muted small">Checkout collects an email for the receipt. The download link works for {DOWNLOAD_WINDOW_DAYS} days after payment. Card details stay with Stripe.</p>
      {showStateLink && <p class="small"><a href={`/states/${book.slug}`}>The {book.name} waterfall guide</a> stays free. This PDF is separate.</p>}
      {showHubLink && <p class="small"><a href="/maps">All waterfall map books</a></p>}
    </div>
  </div>
</section>

<script>
  const checkoutUrl = /^https:\/\/checkout\.stripe\.com\//;
  for (const form of document.querySelectorAll('[data-map-form]')) {
    if (form instanceof HTMLFormElement && form.dataset.bound === '1') continue;
    if (form instanceof HTMLFormElement) form.dataset.bound = '1';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const button = form.querySelector('button');
      const status = form.querySelector('[data-map-status]');
      if (button instanceof HTMLButtonElement && button.disabled) return;
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
      }
      if (status instanceof HTMLElement) {
        status.hidden = false;
        status.textContent = 'Opening checkout.';
      }
      try {
        const state = new FormData(form).get('state');
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ state }),
        });
        const data = await res.json().catch(() => null);
        const url = data && typeof data.url === 'string' ? data.url : '';
        if (!res.ok || !checkoutUrl.test(url)) throw new Error('unavailable');
        window.location.assign(url);
      } catch {
        if (status instanceof HTMLElement) status.textContent = 'Checkout is unavailable right now. Please try again in a moment.';
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      }
    });
  }
</script>

<style>
  .map-book {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 20px;
  }
  .map-book-preview img,
  .map-book-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 8px;
    background: var(--mist);
    border: 1px solid var(--line);
  }
  .map-book-preview img { object-fit: cover; }
  .map-book-placeholder {
    display: grid;
    place-items: center;
    padding: 16px;
    text-align: center;
    color: var(--slate-soft);
    font-size: 0.9rem;
  }
  .map-book ul { margin: 0.4em 0 0.8em; padding-left: 1.2em; }
  .map-book li { margin: 0.2em 0; }
  .map-book .btn { margin-top: 4px; }
  .map-book-status { margin-top: 8px; }
  @media (max-width: 720px) {
    .map-book { grid-template-columns: 1fr; }
    .map-book-preview { max-width: 220px; }
  }
</style>
