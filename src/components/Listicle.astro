---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { listingPhoto } from '../lib/photos.mjs';
import { shortSummary, relativeSummary, listingFacts, directionsUrl, fmtMiles, stars, fmtNum, countyUrl, ratingsUrl } from '../lib/format.mjs';
interface Props { items: { listing: any; miles?: number; direction?: string }[]; from?: string; start?: number }
const { items, from, start = 1 } = Astro.props;
const byReviews = items.filter((x) => x.listing.os?.reviews).sort((a, b) => b.listing.os.reviews - a.listing.os.reviews);
const reviewRank = (x) => (byReviews.includes(x) ? byReviews.indexOf(x) + 1 : 0);
const facts = (x) => {
  const f = listingFacts(x.listing);
  return from ? f.filter(([k]) => k !== 'Nearest town' && k !== 'USGS topo') : f;
};
---
<ol class="listicle" start={start}>
  {items.map(({ listing: l, miles, direction }, i) => (
    <li class="li-item" id={`n${start + i}`}>
      <div class="li-num" aria-hidden="true">{start + i}</div>
      <a class="li-img" href={l.url} tabindex="-1" aria-hidden="true">
        <Photo photo={listingPhoto(l)} eager={i < 2} />
      </a>
      <div class="li-body">
        <h3><a href={l.url}>{l.name}</a></h3>
        <div class="li-meta">
          <a href={l.city.url}>{l.city.name}, {l.stateCode}</a>{l.county && <> · <a href={countyUrl(l)}>{l.county} County</a></>}
          {typeof miles === 'number' && from ? ` · ${fmtMiles(miles)} ${direction} of ${from}` : ''}
        </div>
        {l.os?.rating ? (
          <a class="rating rating-link" href={ratingsUrl(l)} aria-label={`${l.os.rating.toFixed(1)} out of 5 from ${fmtNum(l.os.reviews)} reviews`}><span class="stars" aria-hidden="true">{stars(l.os.rating)}</span>{l.os.rating.toFixed(1)} <span class="count">({fmtNum(l.os.reviews)} reviews)</span></a>
        ) : (
          <div class="rating unrated"><span class="stars empty" aria-hidden="true">☆☆☆☆☆</span><span class="count">Not yet rated</span></div>
        )}
        <p class="li-summary">{from ? relativeSummary(l, { from, miles, direction, index: start - 1 + i, reviewRank: reviewRank(items[i]), total: items.length }) : shortSummary(l)}</p>
        <dl class="li-facts">
          {facts(items[i]).map(([k, v, href]) => <div><dt>{k}</dt><dd>{href ? <a href={href}>{v}</a> : v}</dd></div>)}
        </dl>
        <div class="li-actions">
          <a class="btn btn-primary" href={l.url}>View details</a>
          <a class="btn btn-outline" href={directionsUrl(l)} rel="nofollow noopener" target="_blank"><Icon name="route" />Directions</a>
          {l.os?.phone && <a class="btn btn-outline" href={`tel:${l.os.phone.replace(/[^\d+]/g, '')}`}><Icon name="phone" />Call</a>}
          {l.os?.site && <a class="btn btn-outline" href={l.os.site} rel="nofollow noopener ugc" target="_blank"><Icon name="globe" />Website</a>}
        </div>
      </div>
    </li>
  ))}
</ol>
