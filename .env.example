# Copy to .env for local tooling. Set the same names in the Vercel project.
# Never commit real values. Use a Stripe restricted key (rk_) when you can;
# a secret key (sk_) also works in STRIPE_SECRET_KEY.

# Stripe. Test-mode values until you switch the Vercel environment to live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Annual price id for Waterfalls Near You Plus at $35.99/year.
# Do not put a trial on the Price. Checkout adds the 7-day trial.
STRIPE_PRICE_ID=
# Optional monthly price id at $4.99/month. Leave blank to hide monthly checkout.
STRIPE_PRICE_ID_MONTHLY=

# Postgres connection string. Any of these names works; DATABASE_URL wins.
# Supabase: use the Transaction pooler URI (port 6543), not the direct session URI, for serverless.
DATABASE_URL=
# SUPABASE_DB_URL=
# POSTGRES_URL=
# SUPABASE_URL is not required. The app talks to Postgres with the connection string above.

# Signs session and magic-link tokens. openssl rand -base64 32
AUTH_SECRET=

# Comma-separated emails that can open /admin/users. Must match the sign-in email.
ADMIN_EMAILS=

# Resend. EMAIL_FROM must be a verified domain (or onboarding@resend.dev for tests).
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Cron sends Authorization: Bearer <CRON_SECRET> when this is set.
CRON_SECRET=

# Optional. Links inside emails. Defaults to the production site, or the Vercel URL.
# SITE_URL=https://www.waterfallsnearyou.com
